# ============================================================
# ai/ 环境变量模板
#   1) 复制成 .env      cp .env.example .env
#   2) 填下面的 Key
#   3) .env 已被 .gitignore 排除，永远不会被提交
# ============================================================

# ===== LLM 主端点（必填）=====
# 任何 OpenAI 兼容的 /chat/completions 端点都可以。
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=deepseek-chat

# ===== LLM 备用端点（可选；主端点 429 / 报错时自动兜底）=====
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ===== 桥接（Node 连接 Forge 客户端 mod 的地址）=====
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
# 心跳：每多久主动 ping 一次 / 多久收不到任何来包就判定连接已死
BRIDGE_PING_INTERVAL_MS=10000
BRIDGE_IDLE_TIMEOUT_MS=25000

# ===== 身份 =====
# 你的游戏 ID：AI 靠它判断「谁是自己人」。请不要写进代码，写这里。
MASTER_NAME=player
SELF_NAME=

# ===== 运行参数 =====
MEMORY_FILE=./data/memory.json
# 记忆落盘节流窗口（毫秒）；0 = 每次改动立即写盘
MEMORY_SAVE_THROTTLE_MS=2000
LOOP_STEP_DELAY_MS=1200
ACTION_TIMEOUT_MS=45000
OBSERVE_RADIUS=16
SHORT_TERM_LEN=12
STATE_STALE_MS=6000

# ===== LLM 参数 =====
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=900
LLM_TIMEOUT=30000
LLM_RETRIES=2
LLM_MIN_GAP_MS=1500
# 额外请求体（JSON 字符串），会合并进每次请求的最后，可用来覆盖任何字段。
# 关闭思考模式 / 调整推理强度的常见写法：
#   vLLM 自部署：   {"chat_template_kwargs":{"thinking":false}}
#   DeepSeek 官方： {"thinking":{"type":"disabled"}}
#   NVIDIA NIM：    {"reasoning_effort":1}
LLM_EXTRA_BODY=
# 是否允许把 reasoning_content（模型的思考过程）当作正文兜底。
# 默认 false：思考过程不是答案，直接拿来解析 JSON 会产出垃圾决策。
LLM_REASONING_FALLBACK=false

# ===== 日志 =====
# error | warn | info | verbose | debug
LOG_LEVEL=info
